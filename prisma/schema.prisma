generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant root. One Organization == one team == one subdomain.
/// (A guild can host several orgs — Main + Academy — see plan §10c.)
model Organization {
  id               String           @id @default(cuid())
  slug             String           @unique // → subdomain (g2, wgw-gold)
  name             String
  discordGuildId   String?          @map("discord_guild_id") // not unique: a guild may host several teams
  discordChannelId String?          @map("discord_channel_id")
  plan             String           @default("free")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  schedules        Schedule[]
  schedulePlayers  SchedulePlayer[]
  memberships      Membership[]

  @@map("organizations")
}

/// A person (control-plane identity). One account → many orgs via Membership.
model Account {
  id          String       @id @default(cuid())
  email       String?      @unique
  discordId   String?      @unique @map("discord_id")
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("accounts")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

/// Which orgs an account may access, and with what role. The authority for
/// tenant access control (closes the spoofable-header IDOR).
model Membership {
  id             String       @id @default(cuid())
  accountId      String       @map("account_id")
  organizationId String       @map("organization_id")
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")

  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([accountId, organizationId])
  @@index([accountId])
  @@index([organizationId])
  @@map("memberships")
}

model Schedule {
  id             Int              @id @default(autoincrement())
  organizationId String           @map("organization_id")
  date           String
  reason         String           @default("")
  focus          String           @default("")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  players        SchedulePlayer[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // date is unique per org, not globally
  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@map("schedules")
}

model SchedulePlayer {
  id             Int          @id @default(autoincrement())
  organizationId String       @map("organization_id")
  scheduleId     Int          @map("schedule_id")
  userId         String       @map("user_id")
  displayName    String       @map("display_name")
  role           UserRole
  availability   String       @default("")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  schedule       Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([userId])
  @@index([organizationId])
  @@map("schedule_players")
}

model UserMapping {
  id              Int      @id @default(autoincrement())
  organizationId  String   @map("organization_id")
  discordId       String   @map("discord_id")
  discordUsername String   @map("discord_username")
  displayName     String   @map("display_name")
  role            UserRole
  sortOrder       Int      @default(0) @map("sort_order")
  timezone        String?  @map("user_timezone")
  isAdmin         Boolean  @default(false) @map("is_admin")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, discordId])
  @@index([organizationId])
  @@index([discordId])
  @@index([role, sortOrder])
  @@map("user_mappings")
}

model Scrim {
  id          String       @id
  organizationId String    @map("organization_id")
  date        String
  opponent    String
  result      ScrimResult
  scoreUs     Int          @default(0) @map("score_us")
  scoreThem   Int          @default(0) @map("score_them")
  map         String       @default("")
  matchType   String       @default("") @map("match_type")
  ourAgents   String       @default("") @map("our_agents")
  theirAgents String       @default("") @map("their_agents")
  vodUrl      String       @default("") @map("vod_url")
  matchLink   String       @default("") @map("match_link")
  notes       String       @default("")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  comments    VodComment[]

  @@index([organizationId])
  @@index([date])
  @@map("scrims")
}

model VodComment {
  id        Int      @id @default(autoincrement())
  organizationId String @map("organization_id")
  scrimId   String   @map("scrim_id")
  userName  String   @map("user_name")
  timestamp Int
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  scrim     Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([scrimId, timestamp])
  @@map("vod_comments")
}

model Absence {
  id        Int      @id @default(autoincrement())
  organizationId String @map("organization_id")
  userId    String   @map("user_id")
  startDate String   @map("start_date")
  endDate   String   @map("end_date")
  reason    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([userId])
  @@index([startDate, endDate])
  @@map("absences")
}

model RecurringAvailability {
  id           Int      @id @default(autoincrement())
  organizationId String @map("organization_id")
  userId       String   @map("user_id")
  dayOfWeek    Int      @map("day_of_week") // 0=Sunday, 1=Monday...6=Saturday
  availability String   // "HH:MM-HH:MM" or "x"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, userId, dayOfWeek])
  @@index([organizationId])
  @@index([userId])
  @@index([dayOfWeek])
  @@map("recurring_availabilities")
}

model Setting {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  key            String
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("settings")
}

enum UserRole {
  MAIN
  SUB
  COACH
}

model StrategyFolder {
  id         Int              @id @default(autoincrement())
  organizationId String        @map("organization_id")
  name       String
  parentId   Int?             @map("parent_id")
  color      String?
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  parent     StrategyFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   StrategyFolder[] @relation("FolderTree")
  strategies Strategy[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@map("strategy_folders")
}

model Strategy {
  id         Int              @id @default(autoincrement())
  organizationId String        @map("organization_id")
  title      String
  map        String?
  side       String?
  tags       String           @default("")
  agents     String           @default("")
  content    Json             @default("{}")
  folderId   Int?             @map("folder_id")
  authorId   String           @map("author_id")
  authorName String           @map("author_name")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  folder     StrategyFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  images     StrategyImage[]
  files      StrategyFile[]

  @@index([organizationId])
  @@index([map])
  @@index([side])
  @@index([folderId])
  @@map("strategies")
}

model StrategyImage {
  id           Int       @id @default(autoincrement())
  organizationId String   @map("organization_id")
  strategyId   Int?      @map("strategy_id")
  filename     String    @unique
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  size         Int
  createdAt    DateTime  @default(now()) @map("created_at")

  strategy     Strategy? @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([strategyId])
  @@map("strategy_images")
}

model StrategyFile {
  id           Int      @id @default(autoincrement())
  organizationId String  @map("organization_id")
  strategyId   Int      @map("strategy_id")
  filename     String   @unique
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  strategy     Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([strategyId])
  @@map("strategy_files")
}

enum ScrimResult {
  WIN
  LOSS
  DRAW
}
