{
  "name": "synqed",
  "version": "1.0.0",
  "description": "Synqed — team management platform for Valorant E-Sports teams (Discord bot + web dashboard)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "prisma generate && tsc && node dist/index.js",
    "deploy": "prisma migrate deploy && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "esports",
    "valorant",
    "schedule",
    "team-management",
    "availability",
    "dashboard"
  ],
  "author": "jonax1337",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonax1337/Synqed.git"
  },
  "bugs": {
    "url": "https://github.com/jonax1337/Synqed/issues"
  },
  "homepage": "https://github.com/jonax1337/Synqed#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "vitest": "^4.1.8"
  }
}
